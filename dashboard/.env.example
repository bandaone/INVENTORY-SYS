NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Generate with: openssl rand -base64 48
SUPABASE_PIN_PEPPER=replace_with_at_least_32_random_bytes

DATABASE_URL=postgresql://database_owner:password@host:5432/postgres
APP_DATABASE_URL=postgresql://restricted_app_role:password@host:5432/postgres

# Public application origin used for payment-provider callbacks.
APP_BASE_URL=https://app.example.com
CRON_SECRET=replace_with_at_least_32_random_bytes

# MTN MoMo Collection (production values must never use sandbox placeholders).
MTN_MOMO_SUBSCRIPTION_KEY=replace_me
MTN_MOMO_API_USER=replace_me
MTN_MOMO_API_KEY=replace_me
MTN_MOMO_ENVIRONMENT=production

# Only explicitly approved VSDC bridge hostnames; comma-separated, no schemes.
ZRA_ALLOWED_HOSTS=vsdc-gateway.example.com

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Product analytics is opt-in and records pathnames only (no query strings).
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
